# ---- NoneBot2 基础配置 ----
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# 指令前缀，/bug 才能被识别。留空数组则必须 @机器人 才触发
COMMAND_START=["/"]

# 超级用户 QQ 号（可选，逗号分隔），用于将来加管理指令
# SUPERUSERS=["123456789"]

# ---- 自定义 ----
# 桥接目录：机器人与 WorkBuddy 交换 bug 数据的文件夹。
# bot.py 启动时会用 python-dotenv 把本文件读进进程环境，所以改这里就生效。
# 换一台机器（盘符不同）时只改这一行即可，其余不用动。
BUG_BRIDGE_DIR=D:\work\bug_bridge

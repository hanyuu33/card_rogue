	# ⑪ 盟友卡也吃（打出后抽 1）：证明挂点在**出牌唯一收尾口**而不是技能专属
	var r370_dd4: Array[CardData] = []
	for i in 6:
		r370_dd4.append(_card(9994, "牌%d" % i, "盟友", 2, 2, 6))
	var r370_e5 := _new_engine(r370_dd4, 20, 20, -1, false)

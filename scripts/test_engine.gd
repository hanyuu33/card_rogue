			"R372 第三层起点：进层即满血（%d/%d）—— 起点格只负责回血"
			% [RunState.hp, RunState.max_hp])
	check_src(r372_map.find('"treasure_relic"') < 0,
			"R372 源码锁：直道 cell 也不再带这个键（地图里一次都不出现）")

	# ================= R373：启示者阶段 2 塞「麻痹」 =================
	# 用户口径：「加强启示者 2 阶段效果卡：+每次启示者受到技能伤害，向对方弃牌库中添加一张麻痹。
	# 麻痹：无费用诅咒，不能打出，回合结束在手卡则消失。」
	var r373_paralysis: CardData = repo.get_card(GameEngine.PARALYSIS_CARD_ID)
	check(r373_paralysis != null and r373_paralysis.card_name == "麻痹"
			and r373_paralysis.kind == "诅咒" and r373_paralysis.cost == 0
			and r373_paralysis.unplayable and r373_paralysis.rarity == 6
			and not r373_paralysis.no_remove,
			"R373 麻痹 9185：0 费诅咒 / 不能打出 / 可从卡组删除（unplayable=%s）"
			% str(r373_paralysis.unplayable))
	# ① 不能打出：三个出口 + can_use_card 全拒
	var r373_e0 := _new_engine(_single_deck(_card(8003, "农民", "盟友", 3, 3, 8)), 40, 40, -1, false)
	r373_e0.start_game()
	r373_e0.state.hand.append(CardData.from_dict(r373_paralysis.to_dict()))
	var r373_hi := r373_e0.state.hand.size() - 1
	check(not r373_e0.can_use_card(r373_e0.state.hand[r373_hi]),
			"R373 麻痹：can_use_card 为 false（UI 置灰的同一判据）")
	check(r373_e0.use_curse(r373_hi).find("不能打出") >= 0
			and r373_e0.state.hand.size() == r373_hi + 1,
			"R373 麻痹：use_curse 拒绝且不消耗手牌")
	check(r373_e0.use_spell(r373_hi).find("不能打出") >= 0,
			"R373 麻痹：use_spell 拒绝")
	check(r373_e0.play_from_hand(r373_hi, Vector2i(1, 4)) == null,
			"R373 麻痹：play_from_hand 拒绝（返回 null）")
	# ② 阶段 2 每次吃技能伤害 → 弃牌库 +1；攻击伤害不算；阶段 1 / 3 不算
	var r373_e := _new_engine([], 20, 30)
	r373_e.enemy_hp_infinite = true
	var r373_boss := r373_e.state.place(
			CardData.from_dict(repo.get_card(GameEngine.REVELATOR_ID).to_dict()),
			GameEngine.REVELATOR_HOME, GameEngine.SIDE_OPPONENT)
	r373_boss.boss_phase = 2
	var r373_d0 := r373_e.state.discard.size()
	r373_e._hit_unit(r373_boss, 10, "技能")
	check(r373_e.state.discard.size() == r373_d0 + 1
			and r373_e.state.discard[r373_e.state.discard.size() - 1].id == 9185,
			"R373 阶段 2：受到技能伤害 → 弃牌库 +1 张「麻痹」（%d → %d）"
			% [r373_d0, r373_e.state.discard.size()])
	r373_e._hit_unit(r373_boss, 10, "技能")
	check(r373_e.state.discard.size() == r373_d0 + 2,
			"R373 每次技能伤害各塞一张（多段技能会叠，本回合 %d 张）"
			% (r373_e.state.discard.size() - r373_d0))
	r373_e._hit_unit(r373_boss, 10, "攻击", true, true)
	check(r373_e.state.discard.size() == r373_d0 + 2,
			"R373 攻击伤害不塞麻痹（%d 张）" % (r373_e.state.discard.size() - r373_d0))
	r373_boss.boss_phase = 1
	r373_e._hit_unit(r373_boss, 10, "技能")
	check(r373_e.state.discard.size() == r373_d0 + 2,
			"R373 阶段 1 不塞麻痹")
	r373_boss.boss_phase = 3
	r373_e._hit_unit(r373_boss, 10, "技能")
	check(r373_e.state.discard.size() == r373_d0 + 2,
			"R373 阶段 3 不塞麻痹")
	# ③ 回合结束仍在手卡 → 消失（进消耗区）
	var r373_e2 := _new_engine(_single_deck(_card(8003, "农民", "盟友", 3, 3, 8)), 40, 40, -1, false)
	r373_e2.start_game()
	r373_e2.state.hand.append(CardData.from_dict(r373_paralysis.to_dict()))
	var r373_v0 := r373_e2.state.void_count
	r373_e2.end_turn()
	var r373_left := 0
	for r373_c: CardData in r373_e2.state.hand:
		if r373_c != null and r373_c.id == 9185:
			r373_left += 1
	check(r373_left == 0 and r373_e2.state.void_count == r373_v0 + 1,
			"R373 回合结束：手卡里的麻痹消失（进消耗区 %d → %d）"
			% [r373_v0, r373_e2.state.void_count])
	# ④ 源码锁：唯一口 + unplayable 判据不许只写一处
	var r373_src := FileAccess.get_file_as_string("res://scripts/game_engine.gd")
	check_src(r373_src.find("func _add_paralysis") >= 0
			and r373_src.find("func _paralysis_tick") >= 0,
			"R373 源码：麻痹的「进弃牌库 / 回合结束消失」各有一个唯一口")
	check_src(r373_src.count("unplayable") >= 4,
			"R373 源码：unplayable 在引擎里至少 4 处（can_use_card + 三个出牌入口）")

	# ==== R376：无尽黑暗「面板收起 → 回合结束不了」的死锁（用户上报）====
	# 复现口径：把 9114 放进效果区 → 过一整个来回 → 进入待选弃牌。
	var r376_repo := CardRepo.load_json()
	var r376_eng := _new_engine(_single_deck(_card(1051, "农民", "盟友", 3, 3, 8)), 40, 40, -1, false)
	r376_eng.start_game()
	r376_eng.state.effects.append(CardData.from_dict(r376_repo.get_card(9114).to_dict()))
	r376_eng.end_turn()
	r376_eng.end_turn()
	check(r376_eng.endless_pending,
			"R376 无尽黑暗：回合开始抽牌后进入待选弃牌（pending = true）")
	check(r376_eng.endless_options().size() == r376_eng.state.hand.size(),
			"R376 无尽黑暗：待选候选 = 全部手牌（%d 张）" % r376_eng.state.hand.size())
	# ① 兜底落空：清 pending，不弃牌不给费
	var r376_hand := r376_eng.state.hand.size()
	var r376_energy: int = r376_eng.state.energy
	var r376_disc := r376_eng.state.discard.size()
	r376_eng.endless_abort()
	check(not r376_eng.endless_pending
			and r376_eng.state.hand.size() == r376_hand
			and r376_eng.state.energy == r376_energy
			and r376_eng.state.discard.size() == r376_disc,
			"R376 无尽黑暗：endless_abort 落空 —— 清 pending、不弃牌、不给费还是 %d" % r376_energy)
	check(r376_eng.endless_options().is_empty() and not r376_eng.endless_pick(0),
			"R376 无尽黑暗：落空之后没有候选、也点不动（不会卡在空网格上）")
	# ② 正常路径仍然通：再走一遍，选一张 → 弃 1 张 + 2 费
	r376_eng.end_turn()
	r376_eng.end_turn()
	if r376_eng.endless_pending:
		var r376_e0: int = r376_eng.state.energy
		var r376_h0 := r376_eng.state.hand.size()
		var r376_ok: bool = r376_eng.endless_pick(0)
		check(r376_ok and not r376_eng.endless_pending
				and r376_eng.state.hand.size() == r376_h0 - 1
				and r376_eng.state.energy == r376_e0 + GameEngine.ENDLESS_DARK_ENERGY,
				"R376 无尽黑暗：选一张 → 弃 1 张 + 费用 %d → %d"
						% [r376_e0, r376_eng.state.energy])
	else:
		check(false, "R376 无尽黑暗：第二轮没进入待选（手牌 %d 张）" % r376_eng.state.hand.size())
	# ③ 源码守卫：`_on_end_turn` 里每个「先选完」的守卫都必须先弹回选卡页
	var r376_src := FileAccess.get_file_as_string("res://scripts/battle_scene.gd")
	var r376_a := r376_src.find("func _ensure_pick_visible")
	var r376_b := r376_src.find("func _ai_step")
	var r376_guard := r376_a >= 0 and r376_b > r376_a
	if r376_guard:
		var r376_body := r376_src.substr(r376_a, r376_b - r376_a)
		for r376_kind: String in ["crow", "whale", "endless", "rebirth", "recall", "foresight"]:
			if r376_body.find("_ensure_pick_visible(\"%s\")" % r376_kind) < 0:
				r376_guard = false
	check(r376_guard,
			"R376 源码：_on_end_turn 的 6 条 pending 守卫都调 _ensure_pick_visible（收起后点结束回合会弹回来）")
	check(r376_src.find("engine.endless_abort()") >= 0,
			"R376 源码：_sync_pick 在候选为空时调 endless_abort（不留空网格）")

	print("== 结果：", "全部通过" if fails == 0 else "%d 项失败" % fails, " ==")
	quit(1 if fails > 0 else 0)


func _whisper_far(cells: Array, from_id: int, cleared: Array) -> int:
	## R194 测试专用：从 `from_id` 走到**最近的没走过的房间**要几步（没走过 = 不在
	## `cleared` 里）。全部走完（或坐标非法）时返回一个很大的数。
	## ⚠️ 用「离未探索区域近了几步」当断言口径，而不是「挑中了哪一间」——
	##    同距离的目标有多个时挑路是**随机**的，钉死某一间会写出假失败。
	var d: Dictionary = RogueMap.steps_from(cells, from_id)
	var best := 1 << 30
	for c: Dictionary in cells:
		if not cleared.has(int(c["id"])):
			best = mini(best, int(d.get(int(c["id"]), 1 << 30)))
	return best

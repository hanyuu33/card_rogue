	# ---- ② 下个回合开始：实验组比对照组多抽 1 张（牌库 / 手牌双对照） ----
	var r201_ctl := _new_engine([], 30, 30, -1, false)
	r201_ctl.start_game()
	var r201_exp := _new_engine([], 30, 30, -1, false)
	r201_exp.start_game()
	for _i in 12:

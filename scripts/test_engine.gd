	var eng_pc4 := _new_engine(wm_deck, 20, 20, -1, false)
	eng_pc4.self_relics = [6014]
	eng_pc4.start_game()
	eng_pc4.state.place(_card(9016, "犀牛", "盟友", 4, 6, 12, 1, 2),
			Vector2i(4, 1), GameEngine.SIDE_SELF)

	var r367_lo := RunRecord.list_records()
	check(r367_lo.size() == 1 and str(r367_lo[0].get("result", "")) == "lose",
		"R367 记录：明确打完的一局 —— pending 丢了也兜一条「失败」")
	check(int(r367_lo[0].get("hp", -1)) == 0,
		"R367 记录：兜底写出的失败记录同样「生命记 0」")

	# ---- 中断补记必须用 pending 里的快照（不被新局内存状态盖掉）----
	RunRecord.clear_all()
	var r367_f := FileAccess.open(RunRecord.PENDING_PATH, FileAccess.WRITE)
	r367_f.store_string(JSON.stringify({
		"format": RunRecord.FORMAT, "session": "r367-old",
		"time": "2026-01-01T00:00:00", "start_unix": 0, "elapsed": 100,
		"class": "森林精魄", "difficulty": 0, "seed": 4242,
		"snap": {"hp": 7, "max_hp": 50, "gold": 33, "layer": 1,
				"battles": 3, "elites": 1, "relics": [6001], "deck": []}}))
	r367_f = null
	RunState.run_active = true
	RunState.hp = 44          # 内存里是「另一局」的状态
	RunState.gold = 999
	RunRecord.finish("interrupted")
	var r367_it := RunRecord.list_records()
	check(r367_it.size() == 1 and int(r367_it[0].get("hp", -1)) == 7
			and int(r367_it[0].get("gold", -1)) == 33,
		"R367 记录：中断补记用 pending 的快照（不被新局内存状态盖掉）")

	# ---- 源码守卫：三条链路的唯一入口 ----
	var r367_bs := FileAccess.get_file_as_string("res://scripts/battle_scene.gd")
	check_src(r367_bs.find("RunState.spend_relic(RunState.BASIN_RELIC_ID)") >= 0,
		"R367 源码：钢盆归零走 spend_relic（不是 lose_relic）")
	check_src(r367_bs.find("RunState.spend_relic(RunState.CAVE_ROPE_RELIC_ID)") >= 0,
		"R367 源码：洞窟绳用掉走 spend_relic")
	check_src(r367_bs.find("engine.self_relics = RunState.active_relics()") >= 0,
		"R367 源码：引擎拿到的是排除已耗尽的那份道具表")
	check_src(r367_bs.find("func _record_defeat()") >= 0
			and r367_bs.find("_record_defeat()") >= 0,
		"R367 源码：败北记账有唯一入口 _record_defeat")
	check_src(r367_bs.find("if engine.over and not _over_shown and engine.result != \"胜利\":") >= 0,
		"R367 源码：`engine.over` 首帧就记败北（不等结算面板）")
	check_src(r367_bs.find("RunRecord.finish(\"lose\", true)") >= 0,
		"R367 源码：失败记账允许兜底（pending 丢了也要留痕）")
	check_src(r367_bs.find("RunState.note_boss_kill(") >= 0,
		"R367 源码：Boss 通关时写入每层战果")
	var r367_rsrc := FileAccess.get_file_as_string("res://scripts/run_state.gd")
	check_src(r367_rsrc.find("static func spend_relic") >= 0
			and r367_rsrc.find("static func active_relics") >= 0,
		"R367 源码：spend_relic / active_relics 是道具灰显的唯一口")
	check_src(r367_rsrc.find("return relics.has(id) and not spent_relics.has(id)") >= 0,
		"R367 源码：has_relic 排除已耗尽（生效判定只有这一个口）")

	# ---- 收尾：把真实记录文件还回去 ----
	RunState.end_run(false)
	RunState.relics = []
	RunState.spent_relics.clear()
	RunState.boss_kills.clear()
	if r367_rec_bak == "":
		RunRecord.clear_all()
	else:
		var r367_rf := FileAccess.open(RunRecord.PATH, FileAccess.WRITE)
		r367_rf.store_string(r367_rec_bak)
		r367_rf = null
	if r367_pend_bak == "":
		if FileAccess.file_exists(RunRecord.PENDING_PATH):
			DirAccess.remove_absolute(ProjectSettings.globalize_path(RunRecord.PENDING_PATH))
	else:
		var r367_pf := FileAccess.open(RunRecord.PENDING_PATH, FileAccess.WRITE)
		r367_pf.store_string(r367_pend_bak)
		r367_pf = null

	# ================= R369：商店 / 篝火保底 + 冲击炮与击退调参 =================
	# 用户口径：「除了右上角的商店，商店保底有 2 个，篝火保底有 2 个，每层（不影响其他概率，
	# 只是保底）」；「冲击炮改为 10 伤害击退 1 格，击退改为 2 费」。
	# ① 权重表一个字没动 —— 保底靠「独立先定 + 补位」实现，不靠挪概率
	check(int(RogueMap.WEIGHTS.get("battle", 0)) == 7
			and int(RogueMap.WEIGHTS.get("event", 0)) == 2
			and int(RogueMap.WEIGHTS.get("elite", 0)) == 2,
			"R369 明房权重未动（7 / 2 / 2）")
	check(int(RogueMap.WEIGHTS_UNKNOWN.get("battle", 0)) == 7
			and int(RogueMap.WEIGHTS_UNKNOWN.get("event", 0)) == 12
			and int(RogueMap.WEIGHTS_UNKNOWN.get("elite", 0)) == 2
			and int(RogueMap.WEIGHTS_UNKNOWN.get("chest", 0)) == 3
			and int(RogueMap.WEIGHTS_UNKNOWN.get("shop", 0)) == 2,
			"R369 / R371 「?」房权重：shop 3 → 2（7 / 12 / 2 / 3 / 2）")
	check(RogueMap.SHOP_MIN == 2 and RogueMap.SHOP_MAX == 2,
			"R369 随机商店保底 2 间（上限也 2：保底不额外拉长随机区间）")
	check(RogueMap.REST_MIN == 2, "R369 篝火保底 2 间（常量）")

	# ② 实测 400 张图 × 两层：每层商店 ≥3 间（1 固定角 + 2 保底）、篝火 ≥2 间
	var r369_bad_shop := 0
	var r369_bad_rest := 0
	var r369_shop_sum := 0
	var r369_rest_sum := 0
	for r369_layer: int in [GameLayers.LAYER_DEFAULT, GameLayers.LAYER_TWO]:
		for r369_k in 200:
			var r369_rng := RandomNumberGenerator.new()
			r369_rng.seed = 369000 + r369_k * 13 + r369_layer
			var r369_map: Array = RogueMap.generate(r369_rng, r369_layer)
			var r369_ns := 0
			var r369_nr := 0
			for r369_c: Dictionary in r369_map:
				if RogueMap.is_void(r369_c):
					continue
				var r369_t := str(r369_c.get("type", ""))
				if r369_t == "shop":
					r369_ns += 1
				elif r369_t == "rest":
					r369_nr += 1
			if r369_ns < 3:
				r369_bad_shop += 1
			if r369_nr < 2:
				r369_bad_rest += 1
			r369_shop_sum += r369_ns
			r369_rest_sum += r369_nr
	check(r369_bad_shop == 0,
			"R369 商店保底：400 张图全部 ≥3 间（1 固定角 + 2 保底；实测均值 %.2f）"
			% (float(r369_shop_sum) / 400.0))
	check(r369_bad_rest == 0,
			"R369 篝火保底：400 张图全部 ≥2 间（实测均值 %.2f）"
			% (float(r369_rest_sum) / 400.0))

	# ③ 冲击炮 = 10 伤 + 击退 1 格；击退 = 2 费
	check(GameEngine.IMPACT_CANNON_DMG == 10 and GameEngine.IMPACT_CANNON_STEPS == 1,
			"R369 冲击炮：常量改为 10 伤 / 击退 1 格")
	var r369_cannon: CardData = repo.get_card(GameEngine.IMPACT_CANNON_ID)
	check(r369_cannon != null and r369_cannon.cost == 2
			and r369_cannon.effect_text.contains("**10**")
			and r369_cannon.effect_text.contains("1 格"),
			"R369 冲击炮卡面：2 费 / 文案写 10 伤 + 击退 1 格")
	var r369_kb: CardData = repo.get_card(9004)
	check(r369_kb != null and r369_kb.cost == 2 and r369_kb.effect_text.contains("2 格"),
			"R369 击退：费用 1 → 2（击退距离仍 2 格）")
	# 源码锁：左栏预览的伤害表也得跟着改（漏了就是「卡面 10、预览 8」）
	var r369_src := FileAccess.get_file_as_string("res://scripts/game_engine.gd")
	check_src(r369_src.find("9163: 10,") >= 0,
			"R369 源码锁：SPELL_BASE_DMG 里 9163 = 10")

	# ================= R370：库存整理 9184 + 附魔「抽牌 +1」 =================
	# 用户口径：「新增机械之心史诗法术，库存整理：1费，将卡组两张卡随机变成另一张卡。
	#            新增附魔种类：打出后抽一张卡，售价40（商店和随机都能得到）」
	# ① 卡面定义
	var r370_inv: CardData = repo.get_card(GameEngine.INVENTORY_ID)
	check(r370_inv != null and r370_inv.card_name == "库存整理"
			and r370_inv.kind == "技能" and r370_inv.cost == 1
			and r370_inv.rarity == 2 and r370_inv.card_class == PlayerClass.MECH
			and r370_inv.target_mode == "none" and not r370_inv.needs_target(),
			"R370 库存整理：1 费 · 史诗 · 机械之心 · 无目标技能（界面点一下就直接施放）")
	# ② 进机械之心奖励池（商店第一行 / 战斗奖励都能摇到）
	var r370_pool: Array[CardData] = repo.reward_pool_for(PlayerClass.MECH)
	var r370_in_pool := false
	for c: CardData in r370_pool:
		if c.id == GameEngine.INVENTORY_ID:
			r370_in_pool = true
	check(r370_in_pool, "R370 库存整理进机械之心奖励池（共 %d 张）" % r370_pool.size())

	# ③ 结算：卡组随机 2 张 → 各变成**另一张**卡（假 id 保证「换过」一定看得出来）
	var r370_deck: Array[CardData] = []
	for i in 6:
		r370_deck.append(_card(9994 + i, "库存%d" % i, "盟友", 2, 2, 6))
	var r370_e := _new_engine(r370_deck, 20, 20, -1, false)
	r370_e.state.hand.clear()
	r370_e.state.hand.append(CardData.from_dict(r370_inv.to_dict()))
	r370_e.state.energy = 10
	var r370_before: Array[int] = []
	for c: CardData in r370_e.state.deck:
		r370_before.append(c.id)
	var r370_txt := r370_e.use_spell(0, null)
	var r370_changed := 0
	for i in r370_e.state.deck.size():
		var c: CardData = r370_e.state.deck[i]
		if c.id != r370_before[i]:
			r370_changed += 1
	check(r370_e.state.deck.size() == 6 and r370_changed == 2,
			"R370 库存整理：卡组张数不变（%d 张），恰好 2 张被换（实际 %d）"
			% [r370_e.state.deck.size(), r370_changed])
	check(r370_e.state.deck.size() - r370_changed == 4,
			"R370 库存整理：另外 4 张原样不动")
	check(r370_txt.contains("2 张"),
			"R370 库存整理：结算说明写明「变了 2 张」（%s）" % r370_txt)
	# 换出来的新卡必须**不是**旧卡 id（池子里的真卡），且是卡库里的正常卡
	var r370_ok_new := true
	for c: CardData in r370_e.state.deck:
		if c.id >= 9994:
			continue
		if repo.get_card(c.id) == null:
			r370_ok_new = false
	check(r370_ok_new, "R370 库存整理：换出来的都是卡库里真实存在的卡（不是假 id / 空壳）")

	# ④ 随机只走引擎 rng → 同种子两次结果一致（回放 / 联机一致性的前提）
	var r370_s1: Array[int] = []
	var r370_s2: Array[int] = []

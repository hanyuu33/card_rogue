	var few_hand: Array[CardData] = [eng_few.state.hand[few_idx], eng_few.state.hand[keep_one]]
	eng_few.state.hand = few_hand
	check(not eng_few.can_play_from_hand(_find(eng_few.state.hand, 9023)),

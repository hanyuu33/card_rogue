	# R128：**事件房间不再遭遇战斗** —— 事件池里的 monster（遭遇怪物）已移除
	check(not GameLayers.event_weights(GameLayers.LAYER_DEFAULT).has("monster")
			and not GameLayers.event_kinds(GameLayers.LAYER_TWO).has("monster"),
			"事件池已移除 monster（两层都不再出「遭遇怪物」）")

	# ==== R128：5×7 格子地图 ====
	check(RogueMap.COLS == 7 and RogueMap.ROWS == 5 and RogueMap.CELLS == 35,
			"地图尺寸：横 7 × 竖 5 = 35 格")
	check(RogueMap.MAX_STEPS == 12, "每层 12 块巧克力（= 最多探索 12 个新房间）")
	check(RogueMap.START_POS == Vector2i(3, 4), "起点固定在最下一行中间 (3,4)")
	check(RogueMap.BIGCHEST_POS.size() == 1 and RogueMap.BIGCHEST_POS[0] == Vector2i(0, 0)
			and RogueMap.SHOP_POS.size() == 1 and RogueMap.SHOP_POS[0] == Vector2i(6, 0),
			"R243 固定格：左上 (0,0) = 大宝箱，右上 (6,0) = 商店")

	var q_mrng := RandomNumberGenerator.new()
	q_mrng.seed = 424242
	var q_map1: Array = RogueMap.generate(q_mrng, GameLayers.LAYER_DEFAULT)
	check(q_map1.size() == RogueMap.CELLS, "生成一张地图：35 个房间")
	var q_scol: Dictionary = RogueMap.start_cell(q_map1)
	check(not q_scol.is_empty() and str(q_scol["type"]) == "start", "起点房类型为 start")
	check(str(RogueMap.cell_at(q_map1, 0, 0)["type"]) == "bigchest"
			and str(RogueMap.cell_at(q_map1, 6, 0)["type"]) == "shop",
			"R243 角格：左上大宝箱 / 右上商店（每张图都一样）")
	check(int(RogueMap.cell_at(q_map1, 3, 4)["id"]) == int(q_scol["id"]),
			"起点就是 (3,4) 那一格")

	# 门必须双向（A 有通往 B 的门 ⇔ B 有通往 A 的门）
	var q_sym_ok := true
	for q_c: Dictionary in q_map1:
		for q_nid in RogueMap.neighbor_ids(q_c):
			if not RogueMap.neighbor_ids(q_map1[int(q_nid)]).has(int(q_c["id"])):
				q_sym_ok = false
	check(q_sym_ok, "地图：门是双向的（A 通向 B ⇔ B 通向 A）")

	# 方向数约束（用户口径：四角 1 / 起点 2~3 / 其他边缘 2~3 / 内部 2~4）
	var q_deg_ok := true
	var q_deg_bad := ""
	for q_c: Dictionary in q_map1:
		var q_d: int = (q_c["doors"] as Array).size()
		var q_lim: Vector2i = RogueMap.limits(int(q_c["col"]), int(q_c["row"]))
		if q_d < q_lim.x or q_d > q_lim.y:
			q_deg_ok = false
			q_deg_bad = "(%d,%d) 有 %d 个方向，应在 %d~%d" % [
					int(q_c["col"]), int(q_c["row"]), q_d, q_lim.x, q_lim.y]
	check(q_deg_ok, "地图：每个房间的方向数都在规定范围内（%s）"
			% ("符合" if q_deg_ok else q_deg_bad))
	check((RogueMap.cell_at(q_map1, 0, 0)["doors"] as Array).size() == 1
			and (RogueMap.cell_at(q_map1, 6, 0)["doors"] as Array).size() == 1
			and (RogueMap.cell_at(q_map1, 0, 4)["doors"] as Array).size() == 1
			and (RogueMap.cell_at(q_map1, 6, 4)["doors"] as Array).size() == 1,
			"地图：四个角只有 1 个方向")
	check((q_scol["doors"] as Array).size() >= 2 and (q_scol["doors"] as Array).size() <= 3,
			"地图：初始房间有 2~3 个方向")
	# R136：用户口径修正 —— **边缘但不是角**的房间至少 2 个方向（旧口径允许 1）。
	# 角仍然是 1（「死路尽头」是设计），起点 2~3、内部 2~4 都不动。
	var q_edge_ok := true
	var q_edge_bad := ""
	var q_edge_min := 9
	for q_c: Dictionary in q_map1:
		var q_ec: int = int(q_c["col"])
		var q_er: int = int(q_c["row"])
		if not RogueMap.is_edge(q_ec, q_er) or RogueMap.is_corner(q_ec, q_er):
			continue
		var q_ed: int = (q_c["doors"] as Array).size()
		q_edge_min = mini(q_edge_min, q_ed)
		if q_ed < 2:
			q_edge_ok = false
			q_edge_bad = "(%d,%d) 只有 %d 个方向" % [q_ec, q_er, q_ed]
	check(q_edge_ok, "R136 地图：边缘但非角的房间至少 2 个方向（最少 %d 个，%s）"
			% [q_edge_min, "符合" if q_edge_ok else q_edge_bad])

	# 连通 + 大宝箱可达性 + 「12 步只能进一个大宝箱」
	var q_map_steps: Dictionary = RogueMap.steps_from(q_map1, int(q_scol["id"]))
	check(q_map_steps.size() == RogueMap.CELLS, "地图：35 个房间全部从起点可达（连通）")
	var q_bA := RogueMap.idx(0, 0)
	var q_bB := RogueMap.idx(6, 0)
	var q_dA: int = int(q_map_steps.get(q_bA, 999))
	var q_dB: int = int(q_map_steps.get(q_bB, 999))
	check(q_dA <= RogueMap.MAX_STEPS and q_dB <= RogueMap.MAX_STEPS,
			"R243 地图：左上大宝箱 %d 步 / 右上商店 %d 步，都在 %d 步内可达"
			% [q_dA, q_dB, RogueMap.MAX_STEPS])

	# 休息点：不与起点相邻、也不与另一个休息点相邻
	var q_rest_ok := true
	var q_rest_bad := ""
	for q_c: Dictionary in q_map1:
		if str(q_c["type"]) != "rest":
			continue
		if RogueMap.neighbor_ids(q_c).has(int(q_scol["id"])):
			q_rest_ok = false
			q_rest_bad = "休息点 (%d,%d) 与起点相邻" % [int(q_c["col"]), int(q_c["row"])]
		for q_nid in RogueMap.neighbor_ids(q_c):
			if str(q_map1[int(q_nid)]["type"]) == "rest":
				q_rest_ok = false
				q_rest_bad = "休息点 (%d,%d) 与另一个休息点相邻" % [int(q_c["col"]), int(q_c["row"])]
	check(q_rest_ok, "地图：休息点不与起点相邻、也不与另一个休息点相邻（%s）"
			% ("符合" if q_rest_ok else q_rest_bad))

	# 类型合法 / 都带 layer / 固定格不会藏成「?」
	var q_type_ok := true
	var q_layer_ok := true
	var q_hidden_ok := true
	var q_hidden_seen := false
	for q_c: Dictionary in q_map1:
		if not RogueMap.TYPE_LABELS.has(str(q_c["type"])):
			q_type_ok = false
		if int(q_c.get("layer", -1)) != GameLayers.LAYER_DEFAULT:
			q_layer_ok = false
		if bool(q_c.get("hidden", false)):
			q_hidden_seen = true
			if str(q_c["type"]) == "start" or str(q_c["type"]) == "bigchest" \
					or RogueMap.is_fixed_shop(int(q_c["id"])):
				q_hidden_ok = false
	check(q_type_ok, "地图：房间类型全部合法")
	check(q_layer_ok, "地图：每个房间都标记了所属层（第一层）")
	check(q_hidden_ok, "地图：「?」房不会盖住起点 / 大宝箱（那两种固定写明）")
	check(q_hidden_seen, "地图：会出「?」房（本张 %s）"
			% ("有" if q_hidden_seen else "没有"))

	# 「?」房：走进前显示为未知，揭晓后永久显示真实类型
	var q_hc: Dictionary = {}
	for q_c: Dictionary in q_map1:
		if bool(q_c.get("hidden", false)):
			q_hc = q_c
			break
	if not q_hc.is_empty():
		check(RogueMap.display_type(q_hc) == "unknown", "「?」房揭晓前显示为未知")
		q_hc["revealed"] = true
		check(RogueMap.display_type(q_hc) == str(q_hc["type"]), "「?」房揭晓后显示真实类型")
		q_hc["revealed"] = false

	# 事件房的 event_kind 必须取自本层事件池
	var q_ev_kind_ok := true
	for q_c: Dictionary in q_map1:
		if str(q_c["type"]) == "event":
			if not GameLayers.event_kinds(GameLayers.LAYER_DEFAULT).has(
					str(q_c.get("event_kind", ""))):
				q_ev_kind_ok = false
	check(q_ev_kind_ok, "地图：事件房的 event_kind 全部取自本层事件池")

	# 批量生成：60 张都必须满足全部约束（生成算法必须稳定，不允许偶发失败）
	var q_bulk_ok := true
	var q_bulk_msg := "全部通过"
	var q_bulk_rng := RandomNumberGenerator.new()
	q_bulk_rng.seed = 777001
	var q_bulk_rest := 0
	var q_bulk_unknown := 0
	var q_bulk_visible_chest := 0   # R243：明格普通宝箱数（必须 0）
	var q_bulk_types := {}
	var q_bulk_worst := 0          # R136：单张最差重摇次数（下限提到 2 后要盯住生成成本）
	for q_trial in 60:
		var q_mp: Array = RogueMap.generate(q_bulk_rng, GameLayers.LAYER_DEFAULT)
		q_bulk_worst = maxi(q_bulk_worst, RogueMap.last_attempts)
		if q_mp.size() != RogueMap.CELLS:
			q_bulk_ok = false
			q_bulk_msg = "第 %d 张生成失败（%d 格）" % [q_trial, q_mp.size()]
			break
		var q_st: Dictionary = RogueMap.steps_from(q_mp, int(RogueMap.start_cell(q_mp)["id"]))
		if q_st.size() != RogueMap.CELLS:
			q_bulk_ok = false
			q_bulk_msg = "第 %d 张不连通" % q_trial
			break
		if int(q_st.get(RogueMap.idx(0, 0), 999)) > RogueMap.MAX_STEPS \
				or int(q_st.get(RogueMap.idx(6, 0), 999)) > RogueMap.MAX_STEPS:
			q_bulk_ok = false
			q_bulk_msg = "第 %d 张左上大宝箱 / 右上商店超过 %d 步" % [q_trial, RogueMap.MAX_STEPS]
			break
		for q_c: Dictionary in q_mp:
			var q_lim2: Vector2i = RogueMap.limits(int(q_c["col"]), int(q_c["row"]))
			var q_dd: int = (q_c["doors"] as Array).size()
			if q_dd < q_lim2.x or q_dd > q_lim2.y:
				q_bulk_ok = false
				q_bulk_msg = "第 %d 张 (%d,%d) 方向数 %d 越界" % [
						q_trial, int(q_c["col"]), int(q_c["row"]), q_dd]
				break
			if str(q_c["type"]) == "rest":
				q_bulk_rest += 1
			if bool(q_c.get("hidden", false)):
				q_bulk_unknown += 1
			elif str(q_c["type"]) == "chest":
				q_bulk_visible_chest += 1   # R243：明格不该出现普通宝箱
			q_bulk_types[str(q_c["type"])] = int(q_bulk_types.get(str(q_c["type"]), 0)) + 1
		# R142：起点每个邻居都必须能「不回头」走到宝箱
		if q_bulk_ok and not RogueMap.exits_reach_chest(q_mp):
			q_bulk_ok = false
			q_bulk_msg = "第 %d 张有起点邻居走不到宝箱" % q_trial
		if not q_bulk_ok:
			break
	check(q_bulk_ok, "地图：连生成 60 张都满足全部约束（%s）" % q_bulk_msg)
	check(int(q_bulk_types.get("bigchest", 0)) == 60
			and int(q_bulk_types.get("start", 0)) == 60
			and int(q_bulk_types.get("shop", 0)) >= 60,
			"R243 地图 60 张统计：大宝箱 1×60 / 起点 60 / 商店 ≥ 1×60（右上角每张必有一间；另加随机 0~1 与「?」房，实测 %d 间）"
			% int(q_bulk_types.get("shop", 0)))
	check(q_bulk_visible_chest == 0,
			"R243 地图 60 张统计：**明格普通宝箱 0 个**（只可能藏在「?」房里，实际 %d）"
			% q_bulk_visible_chest)
	# 反方向：这条规则不能把宝箱**删干净** —— 「?」房里仍然要能摇出宝箱
	# （可见宝箱 = 0 已断言 → 这里统计到的 chest 必然全是隐藏房）。
	check(int(q_bulk_types.get("chest", 0)) > 0 and int(q_bulk_types.get("chest", 0)) < 60 * 35,
			"R243 地图 60 张统计：宝箱仍会从「?」房摇出来（%d 个 / 全部隐藏）"
			% int(q_bulk_types.get("chest", 0)))
	check(q_bulk_rest >= 60 and q_bulk_unknown >= 60,
			"地图 60 张统计：休息点 %d 个、「?」房 %d 个（两类都真实出现）"
			% [q_bulk_rest, q_bulk_unknown])
	# R136：边缘非角下限 1 → 2 之后，生成器必须仍然够便宜（实测 300 张最差 9 次）。
	check(q_bulk_worst <= 40,
			"R136 地图：60 张里单张最多重摇 %d 次（上限 40，0 失败）" % q_bulk_worst)

	# ==== R142：起点的每一个邻居都必须「不回头也能走到宝箱」====
	check(RogueMap.exits_reach_chest(q_map1),
			"R142 地图：起点的每个邻居都能不经过起点走到宝箱")
	# 反例守卫：手工造一张「起点左边是条没有宝箱的死胡同」的图 → 必须判不合格。
	# ⚠️ 不靠随机图碰运气，直接喂一张最小的合成图，把判定本身钉死。
	var q_neg_cells: Array = []
	for q_ni in RogueMap.CELLS:
		q_neg_cells.append({"id": q_ni, "type": "battle", "doors": []})
	var q_sid := RogueMap.idx(RogueMap.START_POS.x, RogueMap.START_POS.y)
	var q_nl := RogueMap.idx(2, 4)      # 死胡同邻居
	var q_nr := RogueMap.idx(4, 4)      # 通向宝箱的邻居
	var q_nb := RogueMap.idx(4, 3)      # 那个宝箱
	q_neg_cells[q_sid]["type"] = "start"
	q_neg_cells[q_sid]["doors"] = [q_nl, q_nr]
	q_neg_cells[q_nl]["doors"] = [q_sid]
	q_neg_cells[q_nr]["doors"] = [q_sid, q_nb]
	q_neg_cells[q_nb]["type"] = "chest"
	q_neg_cells[q_nb]["doors"] = [q_nr]
	check(not RogueMap.exits_reach_chest(q_neg_cells),
			"R142 守卫：起点某邻居是「没有宝箱的死胡同」→ 判定不合格（整张重摇）")
	q_neg_cells[q_nl]["type"] = "chest"
	check(RogueMap.exits_reach_chest(q_neg_cells),
			"R142 守卫：那条死胡同本身就是宝箱 → 判定合格（走过去就拿到了）")
	# 批量：连生成 80 张，每张都必须满足（生成器不允许偶发漏网）
	var q_exit_ok := true
	var q_exit_bad := ""
	var q_exit_rng := RandomNumberGenerator.new()
	q_exit_rng.seed = 90210
	for q_et in 80:
		var q_em: Array = RogueMap.generate(q_exit_rng, GameLayers.LAYER_DEFAULT)
		if not RogueMap.exits_reach_chest(q_em):
			q_exit_ok = false
			q_exit_bad = "第 %d 张有邻居走不到宝箱" % q_et
			break
	check(q_exit_ok, "R142 地图：连生成 80 张全部满足「起点邻居不回头可达宝箱」（%s）"
			% ("全部通过" if q_exit_ok else q_exit_bad))

	# ==== R372：小宝箱统一「免费开 + 只给卡牌」→ 地图不再带 treasure_relic 旗标 ====
	# 原来 R142 在这里断言「旗标是 bool、两种内容都出现过」；R372 把道具那一半删掉之后，
	# 这条断言改成**反向**的：事件房**不许**再出现这个键（否则说明摇骰子又回来了）。
	var q_tr_bad := ""
	var q_tr_n := 0
	var q_tr_rng := RandomNumberGenerator.new()
	q_tr_rng.seed = 31337
	for q_ti in 120:
		var q_tm: Array = RogueMap.generate(q_tr_rng, GameLayers.LAYER_DEFAULT)
		for q_tc: Dictionary in q_tm:
			if str(q_tc["type"]) != "event":
				continue
			if q_tc.has("treasure_relic"):
				q_tr_bad = "事件房 %s 仍带着 treasure_relic 旗标" % str(q_tc.get("event_kind", ""))
				break
			if str(q_tc.get("event_kind", "")) == "treasure":
				q_tr_n += 1
		if q_tr_bad != "":
			break
	check(q_tr_bad == "" and q_tr_n > 0,
			"R372 地图：事件房不再带 treasure_relic 旗标（120 张里卡牌宝箱 %d 个，%s）"
			% [q_tr_n, "符合" if q_tr_bad == "" else q_tr_bad])

	# ---- 第二层地图：layer 标记 + 事件不串层 ----
	var q_l2_rng := RandomNumberGenerator.new()
	q_l2_rng.seed = 424242
	var q_l2: Array = RogueMap.generate(q_l2_rng, GameLayers.LAYER_TWO)
	var q_l2_bad := false
	var q_l2_ev_bad := false
	var q_l2_leak := ""
	# 「只属于第一层」的事件子类型（第二层地图里一个都不该出现）
	var q_l2_only_l1 := ["whisper", "struggle", "arcane", "treasure"]
	for q_l2_n: Dictionary in q_l2:
		if int(q_l2_n.get("layer", -1)) != GameLayers.LAYER_TWO:
			q_l2_bad = true
		if str(q_l2_n["type"]) == "event":
			var q_l2k := str(q_l2_n.get("event_kind", ""))
			if not GameLayers.event_kinds(GameLayers.LAYER_TWO).has(q_l2k):
				q_l2_ev_bad = true
			if q_l2_only_l1.has(q_l2k):
				q_l2_leak = q_l2k
	check(not q_l2_bad, "第二层地图：每个房间都标记 layer = 2")
	check(not q_l2_ev_bad, "第二层地图：事件房只出第二层事件池里的事件（不串第一层）")
	check(q_l2_leak == "", "第二层地图：绝不出现第一层专属事件（本次泄漏：%s）"
			% ("无" if q_l2_leak == "" else q_l2_leak))
	check(RogueMap.steps_from(q_l2, int(RogueMap.start_cell(q_l2)["id"])).size()
			== RogueMap.CELLS, "第二层地图结构照常连通（%d 格）" % RogueMap.CELLS)

	# 多次生成第二层地图：只出第二层专属事件
	var q_l2_ev_ok := true
	var q_l2_ev_seen := {}
	var q_l2_ev_rng := RandomNumberGenerator.new()
	q_l2_ev_rng.randomize()
	for q_l2_i in 40:
		var q_l2m: Array = RogueMap.generate(q_l2_ev_rng, GameLayers.LAYER_TWO)
		for q_l2m_n: Dictionary in q_l2m:
			if str(q_l2m_n["type"]) != "event":
				continue
			var q_l2m_kind := str(q_l2m_n.get("event_kind", ""))
			q_l2_ev_seen[q_l2m_kind] = true
			if not GameLayers.event_kinds(GameLayers.LAYER_TWO).has(q_l2m_kind):
				q_l2_ev_ok = false
	check(q_l2_ev_ok, "第二层地图：event_kind 全部取自第二层事件池（不串到第一层）")
	check(q_l2_ev_seen.has("pear") or q_l2_ev_seen.has("hero") or q_l2_ev_seen.has("bluefish"),
			"第二层地图多次生成：出鸭梨山大/绝赞五换一/蓝色大肥鱼专属事件")

	# ---- R192：起点后第一格（起点的每一个邻居）类型约束 ----
	# 第一层：只可能是事件或一般战斗（不是?/商店/精英/篝火）；
	# 其他层：不会是精英/篝火（篝火本就有「不与起点相邻」约束）。
	var q_r192_rng := RandomNumberGenerator.new()
	q_r192_rng.randomize()
	var q_r192_l1_bad := ""
	var q_r192_l2_bad := ""
	var q_r192_seen_b := false
	var q_r192_seen_e := false
	for q_r192_i in 120:
		var q_r192_m1: Array = RogueMap.generate(q_r192_rng, GameLayers.LAYER_DEFAULT)
		var q_r192_s1: Dictionary = RogueMap.start_cell(q_r192_m1)
		for q_r192_nid: int in (q_r192_s1["doors"] as Array):
			var q_r192_c1: Dictionary = q_r192_m1[q_r192_nid]
			var q_r192_t1 := str(q_r192_c1["type"])
			if q_r192_t1 != "event" and q_r192_t1 != "battle":
				q_r192_l1_bad = q_r192_t1
			if bool(q_r192_c1.get("hidden", false)):
				q_r192_l1_bad = "?房:" + q_r192_t1
			if q_r192_t1 == "battle":
				q_r192_seen_b = true
			if q_r192_t1 == "event":
				q_r192_seen_e = true
		var q_r192_m2: Array = RogueMap.generate(q_r192_rng, GameLayers.LAYER_TWO)
		var q_r192_s2: Dictionary = RogueMap.start_cell(q_r192_m2)
		for q_r192_nid2: int in (q_r192_s2["doors"] as Array):
			var q_r192_c2: Dictionary = q_r192_m2[q_r192_nid2]
			var q_r192_t2 := str(q_r192_c2["type"])
			if q_r192_t2 == "elite" or q_r192_t2 == "rest":
				q_r192_l2_bad = q_r192_t2
	check(q_r192_l1_bad == "", "R192 第一层起点邻居只出事件/一般战斗，且不是?房（违例：%s）"
			% ("无" if q_r192_l1_bad == "" else q_r192_l1_bad))
	check(q_r192_l2_bad == "", "R192 第二层起点邻居不出精英/篝火（违例：%s）"
		% ("无" if q_r192_l2_bad == "" else q_r192_l2_bad))
	check(q_r192_seen_b and q_r192_seen_e,
			"R192 第一层起点邻居：事件与一般战斗都确实会出现（未被写死成单一类型）")

	# ---- R68：同一张地图上事件子类型不重复（全出过一遍后才允许重复）----
	var q_r68_u := {}
	var q_r68_l1 := GameLayers.event_kinds(GameLayers.LAYER_DEFAULT)
	var q_r68_round1 := []
	for _i in q_r68_l1.size():
		q_r68_round1.append(GameLayers.roll_event_kind(GameLayers.LAYER_DEFAULT, q_l2_ev_rng, q_r68_u))
	var q_r68_uniq := {}
	for q_k in q_r68_round1:
		q_r68_uniq[q_k] = true
	check(q_r68_round1.size() == q_r68_uniq.size() and q_r68_uniq.size() == q_r68_l1.size(),
			"R68 事件不重复：连抽 %d 次得到 %d 种互不相同的事件（第一层池子正好 %d 种）"
			% [q_r68_round1.size(), q_r68_uniq.size(), q_r68_l1.size()])
	# R374（用户口径改口）：池子抽空后**不再清空重开** —— 一局只出一次，抽空返回空串。
	# 原来这里断言「第二轮仍能抽到池内事件」，那正是用户要废掉的「同一局重复出同一个事件」。
	var q_r68_round2 := []
	for _i2 in q_r68_l1.size():
		q_r68_round2.append(GameLayers.roll_event_kind(GameLayers.LAYER_DEFAULT, q_l2_ev_rng, q_r68_u))
	var q_r68_all_empty := true
	for q_r68_k2 in q_r68_round2:
		if str(q_r68_k2) != "":
			q_r68_all_empty = false
	check(q_r68_all_empty,
			"R374 事件池抽空后不再重开一轮：再抽 %d 次全部返回空串（实际 %s）"
			% [q_r68_round2.size(), str(q_r68_round2)])
	check(GameLayers.event_kinds(GameLayers.LAYER_TWO).has(
			GameLayers.roll_event_kind(GameLayers.LAYER_TWO, q_l2_ev_rng)),
			"R68 roll_event_kind 不传 used 时行为不变（按权重抽本层事件）")
	var q_r68_map_ok := true
	var q_r68_map_repeat := ""
	var q_r68_map_rng := RandomNumberGenerator.new()
	for q_r68_m in 60:
		var q_r68_map: Array = RogueMap.generate(q_r68_map_rng, GameLayers.LAYER_DEFAULT)
		var q_r68_cnt := {}
		var q_r68_pool_n: int = GameLayers.event_kinds(GameLayers.LAYER_DEFAULT).size()
		var q_r68_ev_total := 0
		for q_r68_n: Dictionary in q_r68_map:
			if str(q_r68_n["type"]) != "event":
				continue
			q_r68_ev_total += 1
			var q_r68_kind := str(q_r68_n.get("event_kind", ""))
			if q_r68_cnt.has(q_r68_kind) and q_r68_ev_total <= q_r68_pool_n:
				q_r68_map_ok = false
				q_r68_map_repeat = "%s ×%d" % [q_r68_kind, int(q_r68_cnt[q_r68_kind]) + 1]
			q_r68_cnt[q_r68_kind] = int(q_r68_cnt.get(q_r68_kind, 0)) + 1
	check(q_r68_map_ok, "R68 整图：60 张第一层地图上事件子类型均不重复（首个轮次内），违例 %s"
			% ("无" if q_r68_map_ok else q_r68_map_repeat))
	var q_r68_l2_ok := true
	var q_r68_l2_bad := ""
	var q_r68_l2_pool_n: int = GameLayers.event_kinds(GameLayers.LAYER_TWO).size()
	for q_r68_m2 in 60:
		var q_r68_map2: Array = RogueMap.generate(q_r68_map_rng, GameLayers.LAYER_TWO)
		var q_r68_cnt2 := {}
		var q_r68_seen2 := 0
		for q_r68_n2: Dictionary in q_r68_map2:
			if str(q_r68_n2["type"]) != "event":
				continue
			q_r68_seen2 += 1
			var q_r68_k2 := str(q_r68_n2.get("event_kind", ""))
			if q_r68_cnt2.has(q_r68_k2) and q_r68_seen2 <= q_r68_l2_pool_n:
				q_r68_l2_ok = false
				q_r68_l2_bad = "%s（第 %d 个事件房）" % [q_r68_k2, q_r68_seen2]
			q_r68_cnt2[q_r68_k2] = int(q_r68_cnt2.get(q_r68_k2, 0)) + 1
	check(q_r68_l2_ok, "R68 第二层地图：首轮 %d 种事件互不重复，违例 %s"
			% [q_r68_l2_pool_n, ("无" if q_r68_l2_ok else q_r68_l2_bad)])

	# ---- R374（用户口径）：**一个事件在一局里只被抽出一次** ----
	# 旧口径是「一张图内不重复、池子抽空还能重开一轮」，而且 `used` 每层各建一份 →
	# 第一层抽过的「遗忘之泉 / 鸭鸭工匠 / 占卜室」，第二层照样能再抽到（实测 81% 的局都会撞）。
	# 现在：账本 = `RunState.event_kinds_used`（**跨层共用**），池子抽空 → 那格降级成一般战斗。
	var r374_dup := ""
	var r374_total_ok := true
	var r374_cross_ok := true
	for r374_s in 40:
		var r374_bank := {}
		var r374_r1 := RandomNumberGenerator.new()
		r374_r1.seed = 770000 + r374_s
		var r374_m1: Array = RogueMap.generate(r374_r1, GameLayers.LAYER_DEFAULT, null, r374_bank)
		var r374_k1 := {}
		for r374_n1: Dictionary in r374_m1:
			if str(r374_n1["type"]) == "event":
				var r374_e1 := str(r374_n1.get("event_kind", ""))
				if r374_k1.has(r374_e1):
					r374_total_ok = false
				r374_k1[r374_e1] = true
		var r374_r2 := RandomNumberGenerator.new()
		r374_r2.seed = 880000 + r374_s
		var r374_m2: Array = RogueMap.generate(r374_r2, GameLayers.LAYER_TWO, null, r374_bank)
		var r374_k2 := {}
		for r374_n2: Dictionary in r374_m2:
			if str(r374_n2["type"]) != "event":
				continue
			var r374_e2 := str(r374_n2.get("event_kind", ""))
			if r374_k2.has(r374_e2):
				r374_total_ok = false
			r374_k2[r374_e2] = true
			if r374_k1.has(r374_e2):
				r374_cross_ok = false
				if r374_dup == "":
					r374_dup = r374_e2
		# 账本里登记的必须正好是两层出过的那批（一个不多、一个不少）
		var r374_union := r374_k1.duplicate()
		r374_union.merge(r374_k2)
		if r374_union.size() != r374_bank.size():
			r374_total_ok = false
			if r374_dup == "":
				r374_dup = "账本 %d 种 / 图上 %d 种" % [r374_bank.size(), r374_union.size()]
	check(r374_total_ok,
			"R374 一局内每种事件最多出现一次，且账本与图上事件严格对齐（违例：%s）"
			% ("无" if r374_total_ok else r374_dup))
	check(r374_cross_ok,
			"R374 跨层共用账本：第一层出过的事件，第二层不再出（违例：%s）"
			% ("无" if r374_cross_ok else r374_dup))

	# ② 池子用尽 → 那一格降级成一般战斗（不是空事件格、也不是消失的格子）
	var r374_starve_bank := {}
	for r374_k_all in GameLayers.event_kinds(GameLayers.LAYER_DEFAULT):
		r374_starve_bank[r374_k_all] = true
	var r374_srng := RandomNumberGenerator.new()
	r374_srng.seed = 990001
	var r374_smap: Array = RogueMap.generate(r374_srng, GameLayers.LAYER_DEFAULT, null,
			r374_starve_bank)
	var r374_left := 0
	var r374_bad_cell := ""
	for r374_c: Dictionary in r374_smap:
		if str(r374_c["type"]) == "event":
			r374_left += 1
			r374_bad_cell = "仍有事件房：%s" % str(r374_c.get("event_kind", ""))
		if str(r374_c.get("event_kind", "")) != "" and str(r374_c["type"]) != "event":
			r374_bad_cell = "非事件格残留 event_kind"
	check(r374_left == 0 and r374_bad_cell == "",
			"R374 池子先用光 → 整张图不再出现事件房，且没有残留 event_kind（%s）"
			% ("无" if r374_bad_cell == "" else r374_bad_cell))

	# ③ 续档：账本要跟着存档走，否则读档后同一局又能抽到旧事件
	RunState.end_run()
	RunState.start_run([], GameLayers.LAYER_DEFAULT)
	RunState.event_kinds_used = {"whisper": true, "moon": true}
	var r374_snap: Dictionary = RunSave.snapshot()
	RunState.event_kinds_used = {}
	RunSave.apply(r374_snap)
	check(RunState.event_kinds_used.size() == 2 and RunState.event_kinds_used.has("whisper")
			and RunState.event_kinds_used.has("moon"),
			"R374 续档：event_kinds_used 进存档并能原样读回（%s）"
			% str(RunState.event_kinds_used))

	# ④ 外部预生成的地图（map_scene 兜底 / 出图都这么干）→ start_run 要把图上事件登记进账本
	var r374_pre_rng := RandomNumberGenerator.new()
	r374_pre_rng.seed = 660001
	var r374_pre: Array = RogueMap.generate(r374_pre_rng, GameLayers.LAYER_DEFAULT)
	var r374_pre_first := ""
	for r374_pc: Dictionary in r374_pre:
		if str(r374_pc["type"]) == "event":
			r374_pre_first = str(r374_pc.get("event_kind", ""))
			break
	RunState.start_run(r374_pre, GameLayers.LAYER_DEFAULT)
	check(r374_pre_first != "" and RunState.event_kinds_used.has(r374_pre_first),
			"R374 预生成地图：start_run 把图上已有事件登记进本局账本（%s）" % r374_pre_first)
	RunState.end_run()

	# ---- run 流程：开局 / 走节点 / 卡组增长 / 战斗记录持久化 ----
	RunState.end_run()
	var run_rng := RandomNumberGenerator.new()
	run_rng.randomize()
	RunState.start_run(RogueMap.generate(run_rng))
	check(RunState.run_active and RunState.hp == 70 and RunState.max_hp == 70,
			"开局：满血 70/70（默认职业森林精魄，基础50+20）")
	# ---- 道具：起点三选一 / 即时效果 / 卡组编辑 ----
	check(RunState.relic_choice.size() == 3, "开局：初始道具三选一（3 个候选）")
	var relic_uniq := {}
	for rid: int in RunState.relic_choice:
		relic_uniq[rid] = true
	check(relic_uniq.size() == 3, "初始道具候选互不重复")
	var relic_repo := RelicRepo.load_json()
	check(relic_repo.initial_ids().size() == 9 and relic_repo.get_relic(6001) != null
			and relic_repo.get_relic(6004) != null and relic_repo.get_relic(6021) != null,
			"道具库：9 个初始道具全部加载（+ 栅栏修复术 6021 / 行囊 6030 / 勇气徽章 6031 / 陶罐 6032 / R341 惊奇盒子 6047 · 洞窟绳 6048）")
	RunState.choose_start_relic(6001)
	check(RunState.has_relic(6001) and RunState.relic_choice.is_empty()
			and RunState.max_hp == 80 and RunState.hp == 80,
			"类固醇：获得即最大生命 +10（70→80，R340 上调）")
	# ---- 动态难度：前 2 场简单、之后困难（普通与精英各自计数）----
	var nb1 := RunState.next_level({"type": "battle"})
	check(int(nb1["tier"]) == GameLevels.TIER_NORMAL_EASY,
			"第 1 场普通战斗：普通敌人-简单")
	RunState.on_battle_won("battle")
	var nb2 := RunState.next_level({"type": "battle"})
	check(int(nb2["tier"]) == GameLevels.TIER_NORMAL_EASY
			and str(nb2["name"]) != str(nb1["name"]),
			"第 2 场普通战斗：仍为简单，且关卡与本局前面不重复")
	RunState.on_battle_won("battle")
	check(int(RunState.next_level({"type": "battle"})["tier"])
			== GameLevels.TIER_NORMAL_HARD, "第 3 场普通战斗：普通敌人-困难")
	var ne1 := RunState.next_level({"type": "elite"})
	check(int(ne1["tier"]) == GameLevels.TIER_ELITE_EASY, "第 1 场精英：精英敌人-简单")
	RunState.on_battle_won("elite")
	check(int(RunState.next_level({"type": "elite"})["tier"])
			== GameLevels.TIER_ELITE_EASY, "第 2 场精英：仍为精英敌人-简单")
	RunState.on_battle_won("elite")
	check(int(RunState.next_level({"type": "elite"})["tier"])
			== GameLevels.TIER_ELITE_HARD, "第 3 场精英：精英敌人-困难")
	check(int(RunState.next_level({"type": "boss"})["tier"]) == GameLevels.TIER_BOSS,
			"Boss 节点：固定 Boss 关")
	# 地图上常驻的 Boss 名牌（map_scene._draw_boss_chip）取自 **RunState.boss_pick**
	#（R63：同层可能有多个 Boss，开局用 run_rng 摇定一个），必须与实际走进去的那只
	# 是同一只，否则地图会「说谎」。这里 start_run 已跑过 → boss_pick 一定有值。
	check(not RunState.boss_pick.is_empty()
			and str(RunState.boss_pick["name"])
			== str(RunState.next_level({"type": "boss"})["name"]),
			"Boss 名牌 = 实际进入的 Boss 关（本层从 boss_pool 摇定的那只）")
	check(RunState.deck_ids.size() == 13, "初始卡组 13 张（含角色卡熊×1）")
	check(RunState.deck_ids.size() == 13, "初始卡组 13 张（含角色卡熊×1）")
	var start_cell_d: Dictionary = RogueMap.start_cell(RunState.map_cells)
	check(RunState.current_node_id == int(start_cell_d["id"]),
			"起点 = 最下一行中间 (3,4) 那一格")
	check(RunState.chocolate == RogueMap.MAX_STEPS,
			"开局：每层 12 块巧克力（当前 %d）" % RunState.chocolate)
	check(RunState.cleared_ids.size() == 1
			and RunState.cleared_ids.has(int(start_cell_d["id"])),
			"开局：足迹里只有起点（初始点算「已走过」，走回去不扣巧克力）")
	var avail := RunState.available_nodes()
	check(avail.size() == (start_cell_d["doors"] as Array).size()
			and avail.size() >= 2,
			"从起点可选的房间 = 起点有门的相邻房（%d 个）" % avail.size())

	# ==== R145：迷雾视野规则（判定口 = RunState.known_node）====
	# 规则：**通路全图可见**，但「格子里是什么」默认被迷雾遮住；看得见的只有
	# ①走过的房间 ②当前房间 ③当前房间有门的邻居（=「下一步」）④地标（起点 + 大宝箱）。
	var fog_here := int(start_cell_d["id"])
	var fog_nbs: Array = RogueMap.neighbor_ids(start_cell_d)
	var fog_here_ok := RunState.known_node(fog_here)
	for fid in fog_nbs:
		if not RunState.known_node(int(fid)):
			fog_here_ok = false
	check(fog_here_ok,
			"R145 迷雾：当前房间与「下一步」的 %d 间相邻房都看得见" % fog_nbs.size())
	check(RunState.known_node(RogueMap.idx(0, 0))
			and RunState.known_node(RogueMap.idx(6, 0))
			and RunState.is_landmark_node(RogueMap.idx(0, 0))
			and RunState.is_landmark_node(fog_here),
			"R145 迷雾：地标（起点 + 大宝箱 + 右上固定商店）不被迷雾遮住 —— 路线才规划得了")
	var fog_far_n := 0
	var fog_far_known := 0
	var fog_far_id := -1
	for fc: Dictionary in RunState.map_cells:
		var fid2 := int(fc["id"])
		if fid2 == fog_here or fog_nbs.has(fid2) \
				or RunState.is_landmark_node(fid2):
			continue
		fog_far_n += 1
		if RunState.known_node(fid2):
			fog_far_known += 1
		else:
			fog_far_id = fid2
	check(fog_far_n > 0 and fog_far_known == 0,
			"R145 迷雾：其余 %d 格全部看不见（意外可见 %d 格）" % [fog_far_n, fog_far_known])
	# 鹰哨（6026）→ 全图迷雾散尽；摘掉又回到迷雾
	var fog_saved_relics: Array = RunState.relics.duplicate()
	RunState.relics.append(RunState.EAGLE_WHISTLE_RELIC_ID)
	var fog_all_ok := true
	for fc: Dictionary in RunState.map_cells:
		if not RunState.known_node(int(fc["id"])):
			fog_all_ok = false
	check(fog_all_ok, "R145 迷雾：持有鹰哨（6026）时 %d 格全部可见"
			% RunState.map_cells.size())
	RunState.relics = fog_saved_relics
	check(fog_far_id >= 0 and not RunState.known_node(fog_far_id),
			"R145 迷雾：摘掉鹰哨后远处的格子重新被迷雾遮住")
	# R207：「揭开过的迷雾不还原」—— 先记下此刻（站在起点）看得见的全部格子，
	# 走一步之后它们**不许**再被雾盖回去（旧规则只看当前 + 邻居，走开就重新遮住）。
	var fog_seen_before: Array = []
	for fsb: Dictionary in RunState.map_cells:
		if RunState.known_node(int(fsb["id"])):
			fog_seen_before.append(int(fsb["id"]))
	check(not fog_seen_before.is_empty() and RunState.seen_ids.size() >= fog_seen_before.size(),
			"R207 迷雾：看清过的格子都进了 seen_ids（看得见 %d 格 / 已记忆 %d 格）"
			% [fog_seen_before.size(), RunState.seen_ids.size()])
	var first_new: Dictionary = avail[0]
	var choco_before := RunState.chocolate
	var mv := RunState.advance(int(first_new["id"]))
	check(bool(mv["ok"]) and bool(mv["is_new"]) and int(mv["cost"]) == 1,
			"走进没走过的房间：标记为新房间、消耗 1 块巧克力")
	check(RunState.chocolate == choco_before - 1,
			"巧克力 %d → %d" % [choco_before, RunState.chocolate])
	check(RunState.cleared_ids.has(int(start_cell_d["id"]))
			and RunState.cleared_ids.has(int(first_new["id"]))
			and RunState.current_node_id == int(first_new["id"]),
			"前进：起点与新房间都记为已走过，当前位置更新")
	# R145：换房间后「下一步」跟着更新（新位置门后的房间立刻看得见）
	var fog_next_ok := true
	for n5: Dictionary in RunState.available_nodes():
		if not RunState.known_node(int(n5["id"])):
			fog_next_ok = false
	check(fog_next_ok, "R145 迷雾：走到新房间后，「下一步」换成新位置的相邻房"
			+ "（走过的房间仍然可见）")
	# R207：走开之后，刚才在起点看见的那一圈「一格都不许还原」
	var fog_restored := 0
	for fsv in fog_seen_before:
		if not RunState.known_node(int(fsv)):
			fog_restored += 1
	check(fog_restored == 0,
			"R207 迷雾：走开后已揭开的 %d 格全部仍然可见（还原了 %d 格）"
			% [fog_seen_before.size(), fog_restored])
	# ==== R146：开场巡场的「放大 + 拖回我方并还原大小」（battle_scene）====
	# 时间轴是纯函数 `intro_pose(t)` → 直接钉死四段；几何（不漏色）靠出图 + 像素比对核验。
	var r146bs := load("res://scripts/battle_scene.gd")
	var r146_k: Dictionary = r146bs.get_script_constant_map()
	var r146_dur := float(r146_k["GRID_INTRO_DUR"])
	var r146_zoom := float(r146_k["GRID_INTRO_ZOOM"])
	var r146_hold0 := float(r146_k["GRID_INTRO_HOLD0"])
	var r146_hold1 := float(r146_k["GRID_INTRO_HOLD1"])
	var r146_back := float(r146_k["GRID_INTRO_BACK"])
	var r146_pan := r146_dur - r146_hold0 - r146_hold1 - r146_back
	var r146_smax := float(r146bs._grid_scroll_max())
	var r146_smin := float(r146bs._grid_scroll_min())
	check(r146_pan > 0.4 and r146_back > 0.4,
			"R146 巡场时间轴：四段都有料（平移 %.2fs / 回程 %.2fs，总 %.1fs）"
			% [r146_pan, r146_back, r146_dur])
	var r146_start: Dictionary = r146bs.intro_pose(0.0)
	check(is_equal_approx(float(r146_start["scroll"]), r146_smax)
			and is_equal_approx(float(r146_start["zoom"]), 1.0),
			"R146 巡场起点：停在自己半场（scroll=%.0f）、原大小" % r146_smax)
	var r146_end: Dictionary = r146bs.intro_pose(r146_dur)
	check(is_equal_approx(float(r146_end["scroll"]), r146_smax)
			and is_equal_approx(float(r146_end["zoom"]), 1.0),
			"R146 巡场终点：**回到我方半场 + 还原原大小**（%.1f / %.2f —— 用户口径的最后一段）"
			% [float(r146_end["scroll"]), float(r146_end["zoom"])])
	# 敌方半场停留：滚到最上（min）且**放大到 ZOOM**（用户口径：拖向敌人那边时适当放大）
	var r146_hold: Dictionary = r146bs.intro_pose(r146_hold0 + r146_pan + r146_hold1 * 0.5)
	check(is_equal_approx(float(r146_hold["scroll"]), r146_smin)
			and is_equal_approx(float(r146_hold["zoom"]), r146_zoom),
			"R146 敌方半场停留：滚到最上（%.0f）+ 放大到 %.2f" % [r146_smin, r146_zoom])
	check(r146_zoom > 1.0 and r146_zoom <= 1.25,
			"R146 放大倍率 %.2f 属于「适当放大」（>1 且不激进 —— 棋盘左右只有 6px 余量）"
			% r146_zoom)
	# 去程 / 回程中点：位置与大小**同步**（两段是同一条路径的正反走）
	var r146_mid_a: Dictionary = r146bs.intro_pose(r146_hold0 + r146_pan * 0.5)
	var r146_mid_b: Dictionary = r146bs.intro_pose(r146_dur - r146_back * 0.5)
	check(is_equal_approx(float(r146_mid_a["zoom"]), (1.0 + r146_zoom) * 0.5)
			and float(r146_mid_a["scroll"]) < r146_smax - 1.0
			and float(r146_mid_a["scroll"]) > r146_smin + 1.0,
			"R146 去程中点：位置离开我方半场、大小已在放大途中（%.1f / %.3f）"
			% [float(r146_mid_a["scroll"]), float(r146_mid_a["zoom"])])
	check(is_equal_approx(float(r146_mid_b["zoom"]), (1.0 + r146_zoom) * 0.5)
			and is_equal_approx(float(r146_mid_b["scroll"]), float(r146_mid_a["scroll"])),
			"R146 回程中点：与去程中点同一条路径（位置 %.1f、大小 %.3f 都对得上）"
			% [float(r146_mid_b["scroll"]), float(r146_mid_b["zoom"])])
	# 单调性：去程缩放只增、回程只减（别出现「先缩一下再放大」的抖）
	var r146_mono := true
	var r146_prev := 1.0
	for r146_i in 20:
		var r146_zz := float(r146bs.intro_pose(r146_hold0 + r146_pan * (float(r146_i) / 19.0))["zoom"])
		if r146_zz < r146_prev - 0.0001:
			r146_mono = false
		r146_prev = r146_zz
	for r146_j in 20:
		var r146_zz2 := float(r146bs.intro_pose(
				r146_dur - r146_back + r146_back * (float(r146_j) / 19.0))["zoom"])
		if r146_zz2 > r146_prev + 0.0001:
			r146_mono = false
		r146_prev = r146_zz2
	check(r146_mono, "R146 缩放单调：去程只放大、回程只还原（不会来回抖）")
	check(is_equal_approx(r146bs._intro_ease(0.0), 0.0)
			and is_equal_approx(r146bs._intro_ease(1.0), 1.0)
			and is_equal_approx(r146bs._intro_ease(0.5), 0.5),
			"R146 缓动：两端 0/1、中点 0.5（smoothstep）")
	var r146_c: Vector2 = r146bs._board_zoom_center()
	check(is_equal_approx(r146_c.x, float(r146_k["GRID_X"]) + float(r146_k["GRID_W"]) * 0.5)
			and is_equal_approx(r146_c.y,
				float(r146_k["GRID_Y"]) + float(r146_k["GRID_H"]) * 0.5),
			"R146 放大中心 = 棋盘可视窗中心（%.0f, %.0f —— 窗不动、只有内容放大）"
			% [r146_c.x, r146_c.y])
	check(float(r146_k["GRID_MASK_PAD"]) >= 4.0,
			"R146 遮罩余量 %.1fpx ≥ 4（放大的边框金线 / 外圈投影不外漏到侧栏）"
			% float(r146_k["GRID_MASK_PAD"]))
	# ---- R146 源码守卫：几何靠出图核验，这几条是「接线」不能断 ----
	if not FileAccess.file_exists("res://export_presets.cfg"):
		print("    · R146 源码守卫：打包环境读不到 .gd 源文本 → 跳过（只在 dev 工程/门禁生效）")
	else:

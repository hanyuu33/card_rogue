	check(r356_eff == [GameEngine.REVELATOR_CALL_ID],
			"R356 阶段 3：效果区换成紧急呼叫 9203（实际 %s）" % str(r356_eff))

	# ---- ⑤ 阶段 3「接通代受」：一半（去尾）转给接通友军，剩下的自己吃 ----
	var r356_friend := r356_e.state.place(_card(99002, "接通友军", "盟友", 1, 3, 40, 1, 1),

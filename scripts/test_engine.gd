	check(r372_l1 == 3 and r372_l2 == 3 and r372_l3 == 0,
			"R372 第三层起点：前两层照旧 3 件起始道具，第三层**一件都不摇**（%d / %d / %d）"
			% [r372_l1, r372_l2, r372_l3])

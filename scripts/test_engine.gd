			% r370_e5.state.hand.size())
	# ⑫ 源码锁：钩子必须留在 `_note_card_played()` 里（别处再写第二份 = 重复抽牌）
	var r370_src := FileAccess.get_file_as_string("res://scripts/game_engine.gd")
	check_src(r370_src.find("played.enchant == ENCHANT_DRAW") >= 0,

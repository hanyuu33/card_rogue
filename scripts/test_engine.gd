	# ---- ③ 收下真的会解锁卡牌 / 道具（临时剧情文件，用真实 loader 读）----
	# ⚠️ 不走 `repo.episodes.append()` —— 那样绕过 `_ep` 索引，`episode()` 查不到。
	var r346_probe_path := "user://r346_stories_probe.json"

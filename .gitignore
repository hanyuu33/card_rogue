# Godot 4.x
.godot/
/android/
.mono/
data_*/
mono_crash.*.json
*.translation

# 导出产物
/dist/
export/

# 运行日志与临时文件
_e.txt
_r.txt
_s.txt
_rp.txt
_b.txt
*.tmp

# 调试截图（可重建）
shot_*.png
shot_*.import
screenshot*.png
screenshot*.import
/_exe_title.png
# 根目录的一次性探针图（card_face / 关卡出图校验用，随时可重建）
/_*.png
/_*.png.import

# Python
__pycache__/
*.pyc

# 出图过程档案 art_src/ —— **有意入库**（含所有被弃用的候选图）。
#   靠 art_src/.gdignore 让 Godot 忽略它（不导入、不进发布包）。
#   ⚠️ 别把它写进任何忽略规则。

# R368 例外：启示者阶段 1/3 的探索稿（8 个目录 ≈17MB）。
#   失败原因已逐条写进 art_src/2026-10-24_启示者卡图/README.md「五个坑」，
#   重跑提示词即可复现；定稿来源 raw3 / raw6 / raw9 照常入库。
/art_src/2026-10-24_启示者卡图/raw2/
/art_src/2026-10-24_启示者卡图/raw4/
/art_src/2026-10-24_启示者卡图/raw5/
/art_src/2026-10-24_启示者卡图/raw7/
/art_src/2026-10-24_启示者卡图/raw8/

# R376 例外：机械之心这批的 raw 原图（31 张 ≈45MB）。定稿都裁成了 448×403 的
#   `裁切_*.png` 并已落进 assets/pics/，重跑提示词即可再生。
/art_src/2026-10-25_机械之心卡图/raw/

# BGM 候选曲暂存（~485MB，可由 _download.py / _download_opentracks.js 幂等重下）
# 选曲后只有成品进 assets/audio/bgm/（.ogg，届时入库）
/assets/audio/_audition/raw/
# R360：按轮次分包（r360/ 下）的试听素材同样不入库 —— 只提交脚本 / 试听页 / README，
# 音频可由 _refetch_mp3.py + _make_audition.py 幂等重下。
/assets/audio/_audition/*/raw/
/assets/audio/_audition/*/audition/
# R364：按 zip 偏移抓出来的 loop ogg（12MB）—— 现役副本在 assets/audio/bgm/，
# 这里只是「从哪来的」证据，可由 ../_grab_zip_member.py 重新抓。
/assets/audio/_audition/*/loop/

# 历史验证截图归档（.gdignore 已挡在 res:// 之外，这里再挡 git）
art_src/_shots/

# Godot 4.x
.godot/
/android/
.mono/
data_*/
mono_crash.*.json
*.translation

# 导出产物
/dist/
export/

# R577：Steam AppID（本地离线调试用，因机器而异，不入库）。
#   模板 steam_appid.txt.template 照常入库；真文件填的是各后台自己的 AppID。
#   export_presets.cfg 的 exclude_filter 已含 *.txt，它本来也进不了发行包。
/steam_appid.txt

# 运行日志与临时文件
_e.txt
_r.txt
_s.txt
_rp.txt
_b.txt
_assemble_test.txt
*.tmp

# 调试截图（可重建）
shot_*.png
shot_*.import
screenshot*.png
screenshot*.import
/_exe_title.png
# 根目录的一次性探针图（card_face / 关卡出图校验用，随时可重建）
/_*.png
/_*.png.import

# 根目录跑回归 / 出图留下的日志、消息与存档备份（随时可重建）
/_*.log
/_*_msg.txt
/_bk_*/
/_preview/

# 背景图生成原件的工作目录（裁切前的 1536x1024 出图，已归档进 art_src/，不入库）
/assets/ui/_bgnew/

# Python
__pycache__/
*.pyc

# 出图过程档案 art_src/ —— **有意入库**（含所有被弃用的候选图）。
#   靠 art_src/.gdignore 让 Godot 忽略它（不导入、不进发布包）。
#   ⚠️ 别把它写进任何忽略规则。

# R368 例外：启示者阶段 1/3 的探索稿（8 个目录 ≈17MB）。
#   失败原因已逐条写进 art_src/2026-10-24_启示者卡图/README.md「五个坑」，
#   重跑提示词即可复现；定稿来源 raw3 / raw6 / raw9 照常入库。
/art_src/2026-10-24_启示者卡图/raw2/
/art_src/2026-10-24_启示者卡图/raw4/
/art_src/2026-10-24_启示者卡图/raw5/
/art_src/2026-10-24_启示者卡图/raw7/
/art_src/2026-10-24_启示者卡图/raw8/

# R376 例外：机械之心这批的 raw 原图（31 张 ≈45MB）。定稿都裁成了 448×403 的
#   `裁切_*.png` 并已落进 assets/pics/，重跑提示词即可再生。
/art_src/2026-10-25_机械之心卡图/raw/

# BGM 候选曲暂存（~485MB，可由 _download.py / _download_opentracks.js 幂等重下）
# 选曲后只有成品进 assets/audio/bgm/（.ogg，届时入库）
/assets/audio/_audition/raw/
# R360：按轮次分包（r360/ 下）的试听素材同样不入库 —— 只提交脚本 / 试听页 / README，
# 音频可由 _refetch_mp3.py + _make_audition.py 幂等重下。
/assets/audio/_audition/*/raw/
/assets/audio/_audition/*/audition/
# R364：按 zip 偏移抓出来的 loop ogg（12MB）—— 现役副本在 assets/audio/bgm/，
# 这里只是「从哪来的」证据，可由 ../_grab_zip_member.py 重新抓。
/assets/audio/_audition/*/loop/

# R439：网上搜集的第三方参考图（版权素材）—— 只作内部风格参考，绝不入库、绝不进发布包。
#   抓取脚本 tools/ref_fetch.py 可幂等重下；这里只留 README 记录「学什么/不学什么」。
/art_src/_ref/*/
!/art_src/_ref/README.md
/art_src/_ref/_sheet_*.png

# 历史验证截图归档（.gdignore 已挡在 res:// 之外，这里再挡 git）
art_src/_shots/

# R413：AI 试玩桥的运行时产物（pid / 日志 / 存档备份），一律不入库
/.ai_bridge.pid
/.ai_bridge.log
/.ai_test_backup/
# 根目录一次性探针脚本
/_r[0-9]*.py
/_r[0-9]*.gd

# AI 试玩：连续 Bash 连击计数（每次运行自增，不入库）
tools/ai_play/.aicli_calls

# AI 试玩：聚能炮击「已握有」记忆（本局临时态，不入库）
tools/ai_play/.cannon_seen.json
tools/ai_play/.picked.json
tools/ai_play/.runs.jsonl

# AI 试玩：根目录漫游 / 运行日志（本地产物，不入库）
/.roam*.log
/.runs.jsonl

# R478：未确认卡图的原始出图（1536x1024 带平台水印，可由 manifest 里的 prompt 重跑再生）。
#   只保留裁剪后的 assets/pics/_pending/<id>.png 入库。
/assets/pics/_pending/raw/

# R479：根目录一次性探针 / 审计脚本与日志（跑完即可扔，随时可重建）。
#   卡图探针（_probe_*.gd）承担「改了图必须截图验收」的职责，留在本地即可。
/_probe_*.gd
/_probe_*.png
/_probe_*.log
/_verify.log
/_art_audit.*
/_p[0-9]*.py
/_r[0-9]*_missing.*

# R501：换图前的手工备份（.bak_<时间戳> / .bak2_ / .bak_v8）——
#   只在替换美术时留底对照，随时可弃，不入库（正式图本身照常入库）。
/assets/**/*.png.bak*

# R501：美术验收对照图（PIL 拼的新旧对比图，一次性产物）
/_review/
# R519：art_src 下的批量出图同样是「看完就弃」——一次几十张、上百 MB，只留 tools/
**/_review/
# R500：双机同步时的临时暂存（WIP 出图 + 存档备份），本地留底用，不入库
/_pkg_hold/
# R612：批量截图工具 tools/_shot_scenes.gd 的输出目录（临时验收图，不进包也不入库）
# 写成 `/_shots/*` 而不是 `/_shots/`，是为了让其中的 .gdignore 仍能入库 ——
# 别人 checkout 后第一次跑截图工具时就带着忽略标记，不会把 13 张 png 打进包。
/_shots/*
!/_shots/.gdignore
# R503：跑卡图体检 / 回归后留下的临时文本
/_hits.txt
# R524：关卡总览表的中间产物（tools/dump_levels.gd 导出，_leveltable.py 消费）
/_levels_dump.json

# R609：WorkBuddy 的本地会话数据（记忆 / 日志 / 索引），不是工程代码。
/.workbuddy/

# R609：codex 出图工具的默认落盘目录（87MB 原始出图，已被 .gdignore 挡在包外）。
#   成品走 art_src/<日期_主题>/raw/ 或 assets/，这里只放机器产出的中间图。
/generated-images/

# R609：根目录一次性补丁脚本 / 探针输出 / 回归日志 —— 每轮都会生成，跑完即弃。
#   注意：/**_verify.py** 这类长期工具**不在此列**，别把规则写成 /_*。
/_patch_*.py
/_stage_*.py
/_explore_*.py
/_dedup_*.py
/_fix_*.py
/_e_r*.txt
/_verify_r*.txt
/_msg_r*.txt
/_probe_r*.txt
/_no_bg_audit.*
/_style_*.html
/_review_*.html
/_repro_*.gd
/_bk_*.gd
/_组合新卡_进度.txt

# R609：art_src 下各轮的**第三方参考图**（影之诗 / 游戏王等正版卡图，抓来比对风格用）。
#   与 R439 的 art_src/_ref/ 同一条口径：只作内部参考，**绝不入库**。
#   需要复现时按同目录 README / _yugi_url.txt 重新抓。
/art_src/**/refs/

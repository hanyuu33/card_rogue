; Engine configuration file.
; Godot 4.3 项目配置 —— 卡牌对战 Godot 副本

config_version=5

[application]

config/name="卡牌肉鸽"
run/main_scene="res://scenes/opening.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/ui/icon_android_legacy.png"
boot_splash/bg_color=Color(0.06, 0.05, 0.04, 1)
boot_splash/fullsize=false
boot_splash/image="res://assets/ui/studio_mark.png"
boot_splash/show_image=true
boot_splash/use_filter=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[autoload]

AppInstanceGuard="*res://scripts/app_instance_guard.gd"
TopBar="*res://scripts/top_bar.gd"
BackKey="*res://scripts/back_key.gd"
AiBridge="*res://scripts/ai_bridge.gd"
PerfBoot="*res://scripts/perf_boot.gd"

[debug]

# R763：A8 的崩溃取证入口。日志只留在本机 user://logs/，诊断包才收集。
file_logging/enable_file_logging=true
file_logging/log_path="user://logs/godot.log"
file_logging/max_log_files=5

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
